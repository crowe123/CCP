---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Articles', href: '/articles' },
  { label: 'Service Areas', href: '/service-areas' },
  { label: 'Tools', href: '/tools' },
  { label: 'Resources', href: '/resources' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header id="site-header" class="sticky top-0 z-50 transition-all duration-300" style="background: var(--primary);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="PI Metairie Home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
          <circle cx="17" cy="17" r="10" fill="none" stroke="#c49a3c" stroke-width="3"/>
          <line x1="24.5" y1="24.5" x2="36" y2="36" stroke="#c49a3c" stroke-width="3.5" stroke-linecap="round"/>
          <circle cx="17" cy="17" r="5" fill="#c49a3c" opacity="0.3"/>
        </svg>
        <span class="text-xl font-bold" style="font-family: 'Plus Jakarta Sans', sans-serif; color: #fff;">
          PI <span style="color: var(--accent);">Metairie</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-sm font-medium transition-colors hover:opacity-80"
            style="color: rgba(255,255,255,0.85);"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Phone + CTA -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="tel:+15048333716"
          class="flex items-center gap-2 text-sm font-semibold"
          style="color: var(--accent);"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          (504) 833-3716
        </a>
        <a
          href="/contact"
          class="px-4 py-2 text-sm font-bold text-white transition-all"
          style="background: var(--accent); border-radius: var(--radius);"
          onmouseover="this.style.background='var(--accent-hover)'"
          onmouseout="this.style.background='var(--accent)'"
        >
          Free Consultation
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 text-white"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t" style="border-color: rgba(255,255,255,0.1); background: var(--primary);">
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-2" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="py-2 px-3 text-sm font-medium rounded transition-colors hover:bg-white/10"
          style="color: rgba(255,255,255,0.9);"
        >
          {link.label}
        </a>
      ))}
      <hr style="border-color: rgba(255,255,255,0.15); margin: 0.5rem 0;" />
      <a
        href="tel:+15048333716"
        class="py-2 px-3 text-sm font-semibold"
        style="color: var(--accent);"
      >
        📞 (504) 833-3716
      </a>
      <a
        href="/contact"
        class="py-3 px-4 text-center text-sm font-bold text-white rounded"
        style="background: var(--accent);"
      >
        Free Consultation
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }

  // Add box-shadow on scroll
  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header.style.boxShadow = '0 4px 20px rgba(0,0,0,0.4)';
      } else {
        header.style.boxShadow = 'none';
      }
    });
  }
</script>
