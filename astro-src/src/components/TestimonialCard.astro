---
interface Props {
  quote: string;
  name: string;
  city: string;
  stars?: number;
}
const { quote, name, city, stars = 5 } = Astro.props;
---

<div class="bg-white rounded-lg p-6 shadow-md border border-gray-100 flex flex-col gap-4">
  <div class="flex gap-1" aria-label={`${stars} out of 5 stars`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill={i < stars ? '#c49a3c' : '#d1d5db'}
        class="w-5 h-5"
        aria-hidden="true"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>
  <blockquote class="text-gray-600 leading-relaxed italic">"{quote}"</blockquote>
  <footer>
    <p class="font-semibold text-primary" style="color: var(--primary);">{name}</p>
    <p class="text-sm text-gray-500">{city}</p>
  </footer>
</div>
