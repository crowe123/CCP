---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'Need a Licensed PI in Metairie?',
  subtitle = 'Confidential consultations — no obligation. Available 24/7 for urgent matters.',
} = Astro.props;
---

<div class="cta-banner my-10 rounded-lg px-8 py-10 text-center" style="background: var(--primary);">
  <h3 class="text-2xl font-bold mb-2" style="color: #fff; font-family: 'Plus Jakarta Sans', sans-serif;">{title}</h3>
  <p class="mb-6 text-lg" style="color: rgba(255,255,255,0.85);">{subtitle}</p>
  <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
    <a
      href="tel:+15048333716"
      class="inline-flex items-center gap-2 px-6 py-3 font-bold text-lg transition-all"
      style="background: var(--accent); color: #fff; border-radius: var(--radius);"
      onmouseover="this.style.background='var(--accent-hover)'"
      onmouseout="this.style.background='var(--accent)'"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      (504) 833-3716
    </a>
    <a
      href="/contact"
      class="inline-flex items-center gap-2 px-6 py-3 font-bold text-lg border-2 transition-all"
      style="border-color: var(--accent); color: var(--accent); border-radius: var(--radius);"
      onmouseover="this.style.background='rgba(196,154,60,0.1)'"
      onmouseout="this.style.background='transparent'"
    >
      Free Consultation
    </a>
  </div>
</div>
