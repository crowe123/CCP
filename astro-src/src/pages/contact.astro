---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact' },
];
---

<BaseLayout
  title="Contact PI Metairie | Free Confidential Consultation | (504) 833-3716"
  description="Get a free, confidential consultation with a licensed PI in Metairie. Call (504) 833-3716 or fill out the secure contact form."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section style="background: var(--primary);" class="py-14">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-bold text-white mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">Get a Free, Confidential Consultation</h1>
      <p class="text-lg" style="color: rgba(255,255,255,0.8);">All inquiries are 100% confidential. No obligation. Reach a licensed investigator confidentially today.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

      <!-- Left: Contact Info -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold mb-6" style="color: var(--primary);">Contact Information</h2>

        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(196,154,60,0.15);">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--accent);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold mb-1" style="color: var(--primary);">Phone</p>
              <a href="tel:+15048333716" class="text-lg font-bold" style="color: var(--accent);">(504) 833-3716</a>
              <p class="text-sm mt-1" style="color: var(--gray-500);">Emergency line available 24/7</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(196,154,60,0.15);">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--accent);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold mb-1" style="color: var(--primary);">Email</p>
              <a href="mailto:info@privateinvestigatormetairie.com" class="text-base" style="color: var(--accent);">info@privateinvestigatormetairie.com</a>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(196,154,60,0.15);">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--accent);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold mb-1" style="color: var(--primary);">Address</p>
              <p style="color: var(--gray-600);">One Galleria Blvd., Suite 1900<br/>Metairie, LA 70001</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(196,154,60,0.15);">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--accent);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold mb-1" style="color: var(--primary);">Hours</p>
              <p class="text-sm" style="color: var(--gray-600);">Monday – Friday: 8:00 AM – 8:00 PM</p>
              <p class="text-sm" style="color: var(--gray-600);">Saturday: 9:00 AM – 5:00 PM</p>
              <p class="text-sm font-semibold mt-1" style="color: var(--accent);">Emergency: 24/7</p>
            </div>
          </div>
        </div>

        <!-- Service Areas Note -->
        <div class="mt-8 p-4 rounded-lg" style="background: var(--bg-alt); border-radius: var(--radius);">
          <p class="text-sm font-semibold mb-2" style="color: var(--primary);">Areas Served:</p>
          <p class="text-sm" style="color: var(--gray-600);">Metairie, Kenner, Harahan, River Ridge, Gretna, Harvey, Marrero, New Orleans and surrounding Jefferson Parish communities.</p>
        </div>

        <!-- Confidentiality Note -->
        <div class="mt-4 p-4 rounded-lg border-l-4" style="background: rgba(196,154,60,0.08); border-color: var(--accent);">
          <p class="text-sm font-semibold mb-1" style="color: var(--primary);">🔒 100% Confidential</p>
          <p class="text-sm" style="color: var(--gray-600);">All consultations are completely confidential. Information is never shared with third parties and the subject of an investigation is never contacted.</p>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-bold mb-6" style="color: var(--primary);">Send Us a Message</h2>
        <div class="bg-white rounded-lg p-8 shadow-sm border border-gray-100" style="border-radius: var(--radius-lg);">
          <LeadCaptureForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
